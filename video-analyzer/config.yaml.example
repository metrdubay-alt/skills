# Copy to config.yaml and adjust locally.

# LLM provider for vision and final document generation: openai | anthropic
provider: openai

# Vision-capable model with structured output support.
model: gpt-5.5

# Final document language: ru | en
doc_language: ru

# ASR. The default preset favors predictable CPU speed for Codex desktop.
whisper:
  model: tiny              # tiny | small | medium | large-v3
  device: cpu              # cpu | cuda | auto
  language: null           # null = auto-detect, or "ru" / "en"
  vad_filter: false

# Scene/frame extraction.
scenes:
  detect: false            # false = fast uniform sampling; true = PySceneDetect
  threshold: 27.0
  max_frame_interval: 20.0 # one candidate frame every N seconds in long scenes
  phash_distance: 6

# Vision.
vision:
  batch_size: 5
  max_frame_width: 1568

output_dir: output
